# ── Exclude from Docker build context ──
# Keeps the context small → faster builds, no secret leaks.

.git
.gitignore
.github
.idea
.claude
*.md
LICENSE

# Gradle build output
build/
**/build/
.gradle/
**/.gradle/

# kotlin-js-store/ is NOT excluded: tgminiapp/Dockerfile copies kotlin-js-store/yarn.lock so the
# Kotlin/JS build installs the locked npm versions (reproducible bundle).

# Node (semantic-release)
node_modules/

# OS files
.DS_Store
Thumbs.db

# Docker artefacts (don't send back to context)
docker-compose*.yaml
docker-compose*.yml
Dockerfile*
.dockerignore

# Environment files (never bake into image)
.env
.env.*

# yt-dlp binaries (repo root, server/app) — the server downloads its own at runtime
yt-dlp
**/yt-dlp

# Local runtime data (docker-compose volumes, downloads)
data/
output/
~/

